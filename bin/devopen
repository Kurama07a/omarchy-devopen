#!/bin/bash
# devopen - open an editor, coding agent, or preset combo in any directory,
# driven by the native Omarchy menu.
#
# The menu is Omarchy's own `select` mode (omarchy-menu-select), not a static
# JSONC submenu: custom `provider:` names are not supported by the shipped
# menu plugin, and select mode gives a live list plus fuzzy search for free.

set -uo pipefail

# -------------------------------------------------------------- trust model --
#
# Two different kinds of program get run from here, and treating them alike was
# a real hole:
#
#   1. This script's own machinery - jq, fd, sed, awk, setsid, uwsm-app, the
#      omarchy menu helpers. You never asked for these; they are implementation
#      detail. Resolving them through an inherited PATH meant a file planted
#      earlier on that PATH (say ~/.local/bin/jq) would run on an ordinary
#      widget click. They are now resolved to absolute paths inside an explicit
#      list of trusted directories, under an environment this script builds
#      instead of inheriting.
#
#   2. The tool you configured - the `command` string out of config.json. That
#      one is yours. It goes to the session's own app daemon and is launched
#      with the session environment, exactly as the app launcher would launch
#      it. Second-guessing where its binaries live buys nothing: config.json
#      can already name any command at all, so it sits at the same trust level
#      as your shell profile.
#
# The rule: a poisoned PATH must not be able to change *which* program runs. It
# may still be inherited by the program you explicitly asked for.

# Root-owned directories only. `security.toolPath` in config.json replaces this
# list, for installs that keep the omarchy helpers somewhere else.
DEFAULT_TOOL_PATH="/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"

# Kept when the environment is rebuilt below; everything else is dropped -
# including LD_PRELOAD, LD_LIBRARY_PATH and BASH_ENV, which redirect execution
# just as effectively as PATH does.
ENV_KEEP=(
  HOME USER LOGNAME TERM LANG
  XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_RUNTIME_DIR
  XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
  WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE DISPLAY XAUTHORITY
  DBUS_SESSION_BUS_ADDRESS
  EDITOR
)

# Re-exec once under a closed environment. DEVOPEN_USER_PATH carries the PATH we
# were called with; it is never used to find anything this script runs, only to
# answer "is the tool you configured installed?" when building the picker.
if [[ -z ${DEVOPEN_LIB_ONLY-} && -z ${DEVOPEN_SEALED-} ]]; then
  _self="${BASH_SOURCE[0]}"
  [[ $_self == /* ]] || _self="$PWD/$_self"

  # Located without a PATH search, since a PATH search is the thing being fixed.
  _env=""
  for _d in /usr/bin /bin /usr/local/bin; do
    [[ -x $_d/env ]] && { _env="$_d/env"; break; }
  done
  [[ -n $_env ]] || { printf 'devopen: no env(1) in a trusted directory\n' >&2; exit 1; }

  _keep=(DEVOPEN_SEALED=1 "DEVOPEN_USER_PATH=${PATH-}" "PATH=$DEFAULT_TOOL_PATH")
  for _v in "${ENV_KEEP[@]}"; do
    [[ -n ${!_v+x} ]] && _keep+=("$_v=${!_v}")
  done
  # Our own knobs and the locale. None of these can redirect execution, and the
  # two the seal itself sets are not taken from the caller.
  for _v in ${!DEVOPEN_@} ${!LC_@}; do
    [[ $_v == DEVOPEN_SEALED || $_v == DEVOPEN_USER_PATH ]] && continue
    _keep+=("$_v=${!_v}")
  done

  exec "$_env" -i "${_keep[@]}" "$_self" "$@"
fi

# Your PATH, kept for availability checks and for the editor `devopen config`
# opens - both of which are about your tools, not ours.
USER_PATH="${DEVOPEN_USER_PATH:-${PATH-}}"

VERSION="1.1.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/devopen"
CONFIG_FILE="$CONFIG_DIR/config.json"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/devopen"
CACHE_FILE="$CACHE_DIR/dirs.tsv"

# Where the shipped default config is looked up when the user has none yet.
# The install puts a copy in XDG data; the repo path is the fallback for
# running straight out of a checkout.
default_config_path() {
  local c
  for c in \
    "${DEVOPEN_DEFAULT_CONFIG-}" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/devopen/config.default.json" \
    "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/config/config.default.json" \
    "/usr/share/devopen/config.default.json"
  do
    [[ -n $c && -f $c ]] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

TAB=$'\t'

die() { printf 'devopen: %s\n' "$*" >&2; exit 1; }

# ------------------------------------------------------------------ tools ----
#
# Every program this script runs for itself is looked up here, once, and kept
# as an absolute path. The named ones below are the ones worth being explicit
# about; plain coreutils (cat, mv, head, wc) are still called by name, which is
# safe because PATH is now the trusted list and nothing else.

# Declared global: tests/run.sh sources this file from inside a function, where
# a plain `declare` would make the array local to it and vanish on return.
declare -ga TRUSTED_DIRS=()
declare -gA BIN=()

set_trusted_dirs() { # set_trusted_dirs <colon-separated list>
  local d
  TRUSTED_DIRS=()
  BIN=()
  while IFS= read -r d; do
    [[ $d == /* && -d $d ]] || continue
    TRUSTED_DIRS+=("$d")
  done <<<"${1//:/$'\n'}"
  # What we run and what we search must not drift apart.
  PATH=$(IFS=:; printf '%s' "${TRUSTED_DIRS[*]}")
  export PATH
}

# A bare name, resolved to a regular executable file inside a trusted directory.
# Anything else - a path, a directory, a non-executable - is not a tool.
resolve_bin() { # resolve_bin <name>
  local n="$1" d p
  [[ -n ${BIN[$n]-} ]] && { printf '%s' "${BIN[$n]}"; return 0; }
  [[ -n $n && $n != */* ]] || return 1
  for d in "${TRUSTED_DIRS[@]}"; do
    p="$d/$n"
    [[ -f $p && -x $p ]] || continue
    BIN[$n]="$p"
    printf '%s' "$p"
    return 0
  done
  return 1
}

have_bin() { resolve_bin "$1" >/dev/null; }

# Absolute path or a clear failure - never a fallback to whatever PATH offers.
bin() { # bin <name>
  local p
  p=$(resolve_bin "$1") || die "required program not found in trusted path: $1"
  printf '%s' "$p"
}

notify() {
  local n
  if n=$(resolve_bin omarchy-notification-send); then
    "$n" "devopen" "$*" >/dev/null 2>&1 || true
  else
    printf 'devopen: %s\n' "$*" >&2
  fi
}

# Resolved once per trusted-path change. Required ones fail loudly; the
# optional ones are features that simply switch off when absent.
JQ="" SED="" AWK="" BASH_BIN="" SETSID="" UWSM_APP="" LAUNCH_TUI=""
MENU_SELECT="" MENU_INPUT="" FD="" ZOXIDE="" TIMEOUT=""

init_bins() {
  JQ=$(bin jq); SED=$(bin sed); AWK=$(bin awk); BASH_BIN=$(bin bash)
  SETSID=$(resolve_bin setsid)                    || SETSID=""
  UWSM_APP=$(resolve_bin uwsm-app)                || UWSM_APP=""
  LAUNCH_TUI=$(resolve_bin omarchy-launch-tui)    || LAUNCH_TUI=""
  MENU_SELECT=$(resolve_bin omarchy-menu-select)  || MENU_SELECT=""
  MENU_INPUT=$(resolve_bin omarchy-menu-input)    || MENU_INPUT=""
  FD=$(resolve_bin fd)                            || FD=""
  ZOXIDE=$(resolve_bin zoxide)                    || ZOXIDE=""
  TIMEOUT=$(resolve_bin timeout)                  || TIMEOUT=""
}

set_trusted_dirs "$DEFAULT_TOOL_PATH"
init_bins

# Is a tool *you* configured installed? Answered against your PATH, because
# your editors and agents usually live in ~/.local/bin or a version manager's
# shim directory - never in the trusted system list above.
user_has() { PATH="$USER_PATH" command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------- config ----

ensure_config() {
  [[ -f $CONFIG_FILE ]] && return 0
  mkdir -p "$CONFIG_DIR"
  local src
  if src=$(default_config_path); then
    cp "$src" "$CONFIG_FILE"
  else
    printf '{"scan":{"roots":[{"path":"~","depth":1}]},"tools":{},"presets":{}}\n' >"$CONFIG_FILE"
  fi
}

# An install that keeps the omarchy helpers outside the default list can say so
# in config.json. Deliberately not an environment variable: the environment is
# what we stopped trusting, while config.json already decides which commands
# this plugin may launch at all.
apply_config_tool_path() {
  local custom
  custom=$("$JQ" -r '.security.toolPath // empty' "$CONFIG_FILE" 2>/dev/null)
  [[ -z $custom ]] && return 0
  set_trusted_dirs "$custom"
  init_bins
}

cfg() { # cfg <jq filter> [default]
  local out
  # Not `// empty`: jq's alternative operator treats `false` as absent, which
  # would silently turn every `"gitRepos": false` back into the default.
  out=$("$JQ" -r "$1" "$CONFIG_FILE" 2>/dev/null)
  [[ -n $out && $out != "null" ]] && printf '%s' "$out" || printf '%s' "${2-}"
}

# Config values that reach an arithmetic context. Bash evaluates array
# subscripts inside (( )) and $(( )), so a config string like
# `PIPESTATUS[$(cmd)]` would execute `cmd`. Anything that is not a plain
# non-negative integer is refused and the default used instead.
cfg_int() { # cfg_int <jq filter> <default>
  local out; out=$(cfg "$1" "")
  if [[ $out =~ ^[0-9]+$ ]]; then printf '%s' "$out"; else printf '%s' "$2"; fi
}

is_int() { [[ $1 =~ ^[0-9]+$ ]]; }

cfg_bool() { # cfg_bool <jq filter> <default true|false>
  local out; out=$(cfg "$1" "$2")
  case "$out" in true|false) printf '%s' "$out" ;; *) printf '%s' "$2" ;; esac
}

# The menu's row format is tab-delimited and line-based, so a tab, newline or
# carriage return inside a name would desync the columns. Display fields are
# flattened; the true value is recovered from a lookup table, never by
# re-parsing the text the menu hands back.
flatten() { local s="$1"; s=${s//$'\t'/ }; s=${s//$'\n'/ }; s=${s//$'\r'/ }; printf '%s' "$s"; }

menu_row() { # menu_row <icon> <label> <subtext>
  printf '%s\t%s\t%s' "$(flatten "$1")" "$(flatten "$2")" "$(flatten "$3")"
}

# These two deliberately treat "~" as a literal character: config files and the
# typed-path prompt carry it as text, and it is this function's job to turn it
# into $HOME and back. The tildes below are data, not something to be expanded,
# so SC2088 is suppressed rather than obeyed.
# shellcheck disable=SC2088  # the tildes below are literal text, by design
expand_path() { # ~ and $HOME-relative -> absolute
  local p="$1"
  case "$p" in
    "~") p="$HOME" ;;
    "~/"*) p="$HOME/${p#\~/}" ;;
  esac
  printf '%s' "$p"
}

# shellcheck disable=SC2088  # emits a literal tilde for display, by design
tilde_path() {
  local p="$1"
  if [[ $p == "$HOME" ]]; then printf '~'
  elif [[ $p == "$HOME"/* ]]; then printf '~/%s' "${p#"$HOME"/}"
  else printf '%s' "$p"
  fi
}

# ----------------------------------------------------------- directories ----

ignore_args() {
  local pat
  while IFS= read -r pat; do
    [[ -n $pat ]] && printf '%s\0%s\0' "-E" "$pat"
  done < <("$JQ" -r '.scan.ignore[]? // empty' "$CONFIG_FILE" 2>/dev/null)
}

# A scan is the one part of this script that can be made to run forever: a very
# deep tree, a symlink loop, a stalled network mount. Every sweep gets a
# wall-clock ceiling; without timeout(1) it simply runs unbounded as before.
SCAN_TIMEOUT=20
bounded() {
  if [[ -n $TIMEOUT ]]; then "$TIMEOUT" -k 2 "$SCAN_TIMEOUT" "$@"; else "$@"; fi
}

scan_fresh() {
  local -a ign=()
  mapfile -d '' -t ign < <(ignore_args)

  local max
  max=$(cfg_int '.scan.maxDirs' 5000)
  SCAN_TIMEOUT=$(cfg_int '.scan.timeout' 20)

  local use_git use_all
  use_git=$(cfg_bool '.scan.gitRepos' true)
  use_all=$(cfg_bool '.scan.allDirs' true)

  # 1. pinned
  local p abs
  while IFS= read -r p; do
    [[ -z $p ]] && continue
    abs=$(expand_path "$p")
    [[ -d $abs ]] && printf 'pinned\t%s\n' "${abs%/}"
  done < <("$JQ" -r '.pinned[]? // empty' "$CONFIG_FILE" 2>/dev/null)

  # 2. zoxide frecency
  if [[ $(cfg_bool '.scan.zoxide' true) == true && -n $ZOXIDE ]]; then
    local limit; limit=$(cfg_int '.scan.zoxideLimit' 40)
    while IFS= read -r p; do
      [[ -d $p ]] && printf 'recent\t%s\n' "${p%/}"
    done < <(bounded "$ZOXIDE" query -l 2>/dev/null | head -n "$limit")
  fi

  # 3 + 4. git repos, then plain dirs, per configured root
  local root depth
  while IFS=$'\t' read -r root depth; do
    [[ -z $root ]] && continue
    root=$(expand_path "$root")
    [[ -d $root ]] || continue
    is_int "$depth" || depth=2

    # The root's own row is emitted with the kind it actually has: dedup keeps
    # whichever row comes first, so labelling it `dir` up front would stop the
    # git pass below from ever marking a root that is itself a repository.
    if [[ $use_git == true && -e "$root/.git" ]]; then
      printf 'git\t%s\n' "${root%/}"
    else
      printf 'dir\t%s\n' "${root%/}"
    fi

    if [[ $use_git == true && -n $FD ]]; then
      # Ask fd only for directories and decide here what is a repository.
      # Whether `fd` will match `.git` itself depends on its version and its
      # VCS-ignore rules, and `.git` is a plain file in a worktree or
      # submodule — testing for it directly is right in every one of those
      # cases and the same on every fd.
      bounded "$FD" --absolute-path --type d --max-depth "$depth" \
          --max-results "$max" "${ign[@]}" . "$root" 2>/dev/null \
        | "$SED" -e 's#/*$##' \
        | while IFS= read -r p; do
            [[ -n $p && -e "$p/.git" ]] && printf 'git\t%s\n' "$p"
          done
    fi

    if [[ $use_all == true && -n $FD ]]; then
      bounded "$FD" --absolute-path --type d --max-depth "$depth" \
          --max-results "$max" "${ign[@]}" . "$root" 2>/dev/null \
        | "$SED" -e 's#/*$##' \
        | while IFS= read -r p; do [[ -n $p ]] && printf 'dir\t%s\n' "$p"; done
    fi
  done < <("$JQ" -r '.scan.roots[]? | [.path, (.depth // 2 | tostring)] | @tsv' "$CONFIG_FILE" 2>/dev/null)
}

# Cached because the fd sweep is the only slow part. The cache is rebuilt when
# it ages past scan.cacheTtl, so a repo cloned a moment ago shows up shortly.
scan_dirs() {
  local ttl age max
  ttl=$(cfg_int '.scan.cacheTtl' 120)
  max=$(cfg_int '.scan.maxDirs' 5000)
  mkdir -p "$CACHE_DIR"

  if [[ ${1-} != "--force" && -s $CACHE_FILE ]]; then
    age=$(( $(date +%s) - $(stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0) ))
    if (( age < ttl )); then
      cat "$CACHE_FILE"
      return 0
    fi
  fi

  # Keep only well-formed rows: a kind, a tab, then an absolute path. The path
  # is everything after the first tab, so a directory whose own name contains a
  # tab survives intact (`read -r kind path` splits the same way). A name
  # containing a newline arrives here as split fragments; those have no leading
  # slash, so they are dropped instead of becoming bogus picker entries.
  # `head` is the last word on how many rows a menu can ever be asked to show,
  # whatever the roots and depths in the config add up to.
  scan_fresh | "$AWK" '
    { i = index($0, "\t"); if (i == 0) next
      p = substr($0, i + 1)
      if (substr(p, 1, 1) != "/") next
      if (seen[p]++) next
      print }' 2>/dev/null | head -n "$max" >"$CACHE_FILE.tmp"
  mv -f "$CACHE_FILE.tmp" "$CACHE_FILE"
  cat "$CACHE_FILE"
}

# --------------------------------------------------------------- launching --

tool_field() { "$JQ" -r --arg k "$1" --arg f "$2" '.tools[$k][$f] // empty' "$CONFIG_FILE" 2>/dev/null; }
preset_exists() { [[ -n $("$JQ" -r --arg k "$1" '.presets[$k] // empty' "$CONFIG_FILE" 2>/dev/null) ]]; }
tool_exists() { [[ -n $("$JQ" -r --arg k "$1" '.tools[$k] // empty' "$CONFIG_FILE" 2>/dev/null) ]]; }

# The binary a tool needs, so the menu can hide tools that are not installed.
tool_binary() {
  local cmd; cmd=$(tool_field "$1" command)
  printf '%s' "${cmd%% *}"
}

tool_available() {
  local b; b=$(tool_binary "$1")
  [[ -z $b ]] && return 1
  [[ $b == \$* ]] && return 0
  user_has "$b"
}

launch_tool() { # launch_tool <toolKey> <absDir>
  local key="$1" dir="$2" type cmd appid q
  type=$(tool_field "$key" type); type=${type:-gui}
  cmd=$(tool_field "$key" command)
  appid=$(tool_field "$key" appId)
  [[ -z $cmd ]] && { notify "Unknown tool: $key"; return 1; }

  q=$(printf '%q' "$dir")
  cmd=${cmd//\{dir\}/$q}

  # uwsm-app hands the command to the session's app daemon over a pipe, so the
  # caller's cwd is never inherited. Every launch cd's inside its own shell.
  #
  # `bash -c`, not `bash -lc`: sourcing your profile was how a mutated PATH got
  # in, and it is not needed. The daemon starts the app from the systemd user
  # environment - the same one the app launcher uses - so your editors and
  # agents are found exactly where they normally are. A tool that only exists
  # on a PATH your shell rc builds should be given its full path in config.json;
  # `devopen doctor` will show it as missing until then.
  local -a argv
  if [[ $type == "tui" ]]; then
    [[ -z $appid ]] && appid="org.omarchy.$key"
    [[ -n $LAUNCH_TUI ]] || { notify "omarchy-launch-tui not found"; return 1; }
    argv=("$SETSID" "$LAUNCH_TUI" --app-id="$appid" "$BASH_BIN" -c "cd $q && exec $cmd")
  else
    [[ -n $UWSM_APP ]] || { notify "uwsm-app not found"; return 1; }
    argv=("$SETSID" "$UWSM_APP" -- "$BASH_BIN" -c "cd $q && exec $cmd")
  fi
  [[ -n $SETSID ]] || argv=("${argv[@]:1}")

  if [[ -n ${DEVOPEN_DRY_RUN-} ]]; then
    printf '%q ' "${argv[@]}"; printf '\n'
    return 0
  fi

  "${argv[@]}" >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

open_target() { # open_target <toolOrPresetKey> <dir>
  local key="$1" dir
  dir=$(expand_path "$2")
  [[ -d $dir ]] || die "not a directory: $dir"

  if preset_exists "$key"; then
    local step first=1
    while IFS= read -r step; do
      [[ -z $step ]] && continue
      (( first )) || sleep 0.35
      first=0
      launch_tool "$step" "$dir"
    done < <("$JQ" -r --arg k "$key" '.presets[$k].steps[]? // empty' "$CONFIG_FILE" 2>/dev/null)
    return 0
  fi

  tool_exists "$key" || die "no such tool or preset: $key"
  launch_tool "$key" "$dir"
}

# ------------------------------------------------------------------ menus ---

# However many roots, depths and tools a config adds up to, the menu is never
# handed an unbounded list.
menu_trim() { # menu_trim <array-name>
  local -n rows="$1"
  local cap; cap=$(cfg_int '.menu.maxRows' 500)
  (( cap > 0 && ${#rows[@]} > cap )) && rows=("${rows[@]:0:cap}")
  return 0
}

# Rows are "<glyph>\t<label>\t<subtext>"; the menu returns "<label>\t<subtext>"
# so the subtext doubles as the stable key for rows that share a label.
pick_tool() {
  local rows width
  width=$(cfg_int '.menu.toolWidth' 440)

  rows=$(
    "$JQ" -r '
      [ (.tools   | to_entries[] | {k:.key, v:.value, kind:"tool"}),
        (.presets | to_entries[] | {k:.key, v:.value, kind:"preset"}) ][]
      | [ (.v.icon // ""), (.v.label // .k), (.v.description // ""), .k, .kind ]
      | @tsv' "$CONFIG_FILE" 2>/dev/null
  )

  local icon label desc key kind step ok
  local -a out=()
  local -A bykey=()
  while IFS=$'\t' read -r icon label desc key kind; do
    [[ -z $key ]] && continue
    if [[ $kind == "tool" ]]; then
      tool_available "$key" || continue
    else
      # A preset is offered only when every step it needs is installed.
      ok=1
      while IFS= read -r step; do
        [[ -z $step ]] && continue
        tool_available "$step" || ok=0
      done < <("$JQ" -r --arg k "$key" '.presets[$k].steps[]? // empty' "$CONFIG_FILE" 2>/dev/null)
      (( ok )) || continue
    fi
    [[ -z $desc ]] && desc="$key"
    label=$(flatten "$label"); desc=$(flatten "$desc")
    # Two tools sharing a label and description would be indistinguishable in
    # what the menu returns; nudge the later one so each row maps to one key.
    while [[ -n ${bykey["${label}${TAB}${desc}"]-} ]]; do desc="$desc "; done
    out+=("$(menu_row "$icon" "$label" "$desc")")
    bykey["${label}${TAB}${desc}"]="$key"
  done <<<"$rows"

  (( ${#out[@]} )) || { notify "No tools available. Check $CONFIG_FILE"; return 1; }
  menu_trim out

  local sel
  [[ -n $MENU_SELECT ]] || { notify "omarchy-menu-select not found"; return 1; }
  sel=$(printf '%s\n' "${out[@]}" | "$MENU_SELECT" "Open what?" -- --width "$width") || return 1
  [[ -z $sel ]] && return 1
  printf '%s' "${bykey[$sel]-}"
}

TYPE_A_PATH="Type a path…"

pick_dir() {
  local width height kind path label shown icon
  local -a out=()
  local -A bypath=()
  width=$(cfg_int '.menu.dirWidth' 560)
  height=$(cfg_int '.menu.dirMaxHeight' 0)

  while IFS=$'\t' read -r kind path; do
    [[ -z $path ]] && continue
    label=$(flatten "$(basename "$path")")
    shown=$(flatten "$(tilde_path "$path")")
    case "$kind" in
      pinned) icon="󰐄" ;;
      recent) icon="󰋚" ;;
      git)    icon="󰊢" ;;
      *)      icon="󰉋" ;;
    esac
    # Distinct directories can flatten to the same display text (one holding a
    # tab where the other holds a space). Keep each row's key unique so the
    # selection always resolves to the directory that was actually shown.
    while [[ -n ${bypath["${label}${TAB}${shown}"]-} ]]; do shown="$shown "; done
    out+=("$(menu_row "$icon" "$label" "$shown")")
    bypath["${label}${TAB}${shown}"]="$path"
  done < <(scan_dirs)

  menu_trim out
  out+=("$(menu_row "󰌪" "$TYPE_A_PATH" "enter any directory by hand")")

  local sel
  local -a args=(--width "$width")
  (( height > 0 )) && args+=(--height "$height")
  [[ -n $MENU_SELECT ]] || { notify "omarchy-menu-select not found"; return 1; }
  sel=$(printf '%s\n' "${out[@]}" | "$MENU_SELECT" "Where?" -- "${args[@]}") || return 1
  [[ -z $sel ]] && return 1

  if [[ $sel == "$TYPE_A_PATH"$TAB* ]]; then
    local typed
    [[ -n $MENU_INPUT ]] || { notify "omarchy-menu-input not found"; return 1; }
    typed=$("$MENU_INPUT" "Directory" --width "$width") || return 1
    [[ -z $typed ]] && return 1
    expand_path "$typed"
    return 0
  fi

  # Resolved from the table, never re-parsed out of the returned text, so a
  # tab inside a directory name cannot point this at a different directory.
  local real="${bypath[$sel]-}"
  [[ -z $real ]] && return 1
  printf '%s' "$real"
}

cmd_menu() {
  local tool dir
  tool=$(pick_tool) || exit 0
  [[ -z $tool ]] && exit 0
  dir=$(pick_dir) || exit 0
  [[ -z $dir ]] && exit 0

  if [[ ! -d $dir ]]; then
    notify "No such directory: $dir"
    exit 1
  fi
  open_target "$tool" "$dir"
}

# Directory first, then what to open in it - same pieces, reversed.
cmd_menu_reverse() {
  local tool dir
  dir=$(pick_dir) || exit 0
  [[ -z $dir ]] && exit 0
  tool=$(pick_tool) || exit 0
  [[ -z $tool ]] && exit 0
  open_target "$tool" "$dir"
}

# ------------------------------------------------------------------- misc ---

cmd_doctor() {
  printf 'devopen %s\n' "$VERSION"
  printf 'config:  %s %s\n' "$CONFIG_FILE" "$([[ -f $CONFIG_FILE ]] && echo '(ok)' || echo '(MISSING)')"
  "$JQ" -e . "$CONFIG_FILE" >/dev/null 2>&1 || printf '  !! config is not valid JSON\n'
  printf 'cache:   %s\n' "$CACHE_FILE"

  printf '\ntrusted path (where devopen finds its own tools):\n'
  # Group-write is the 6th character of `ls -l` mode bits, other-write the 9th.
  # -L, because /bin and /sbin are symlinks on Arch and a symlink is always 777.
  local d writable='^.{5}w|^.{8}w'
  for d in "${TRUSTED_DIRS[@]}"; do
    # Not enforced, only reported: a trusted directory anyone can write to is
    # worth knowing about, but on some systems it is also perfectly normal.
    if [[ $(stat -Lc %A "$d" 2>/dev/null) =~ $writable ]]; then
      printf '  %-40s !! group- or world-writable\n' "$d"
    else
      printf '  %s\n' "$d"
    fi
  done

  printf '\ndependencies (resolved inside the trusted path):\n'
  local c p
  for c in jq sed awk bash fd omarchy-menu-select omarchy-menu-input \
           omarchy-launch-tui omarchy-notification-send setsid uwsm-app timeout zoxide; do
    p=$(resolve_bin "$c") || p="MISSING"
    printf '  %-28s %s\n' "$c" "$p"
  done

  printf '\nroots:\n'
  local root depth abs
  while IFS=$'\t' read -r root depth; do
    [[ -z $root ]] && continue
    abs=$(expand_path "$root")
    printf '  %-28s depth=%-3s %s\n' "$root" "$depth" "$([[ -d $abs ]] && echo ok || echo missing)"
  done < <("$JQ" -r '.scan.roots[]? | [.path, (.depth // 2 | tostring)] | @tsv' "$CONFIG_FILE" 2>/dev/null)

  printf '\ntools:\n'
  local k
  while IFS= read -r k; do
    [[ -z $k ]] && continue
    printf '  %-14s %-6s %s\n' "$k" "$(tool_field "$k" type)" \
      "$(tool_available "$k" && echo available || echo "missing: $(tool_binary "$k")")"
  done < <("$JQ" -r '.tools | keys[]?' "$CONFIG_FILE" 2>/dev/null)

  printf '\ndirectories found: %s\n' "$(scan_dirs --force | wc -l)"
}

usage() {
  cat <<USAGE
devopen $VERSION - open an editor, agent, or preset in any directory.

Usage:
  devopen [menu]            Pick what to open, then where (default)
  devopen where             Pick where first, then what
  devopen open <what> <dir> Open directly, e.g. devopen open claude ~/Projects/app
  devopen dirs              Print the discovered directories
  devopen tools             Print configured tools and presets
  devopen sync              Rebuild the directory cache now
  devopen config            Edit the config file
  devopen doctor            Show config, dependencies and what was found
  devopen help

Config: $CONFIG_FILE
USAGE
}

# ------------------------------------------------------------------- main ---

# tests/run.sh sources this file to exercise the functions directly. `return`
# only works when sourced; if the flag is set on a direct run, stop anyway
# rather than falling through into the command dispatch below.
if [[ -n ${DEVOPEN_LIB_ONLY-} ]]; then
  # Read-only: a source must not create a config that was not there.
  [[ -f $CONFIG_FILE ]] && apply_config_tool_path
  return 0 2>/dev/null || exit 0
fi

ensure_config
apply_config_tool_path

case "${1:-menu}" in
  menu|"")      cmd_menu ;;
  where)        cmd_menu_reverse ;;
  open)         shift; (( $# >= 2 )) || die "usage: devopen open <tool|preset> <dir>"; open_target "$1" "$2" ;;
  dirs)         scan_dirs "${2-}" | while IFS=$'\t' read -r k p; do printf '%-7s %s\n' "$k" "$p"; done ;;
  tools)        "$JQ" -r '"tools:", (.tools|to_entries[]|"  \(.key)\t\(.value.label // "")"), "", "presets:", (.presets|to_entries[]|"  \(.key)\t\(.value.label // "") [\(.value.steps|join(" + "))]")' "$CONFIG_FILE" ;;
  sync)         scan_dirs --force >/dev/null && echo "devopen: cached $(wc -l <"$CACHE_FILE") directories" ;;
  # Your editor, so your PATH - the same reasoning as the tools in config.json.
  config)       PATH="$USER_PATH" exec "${EDITOR:-omarchy-launch-editor}" "$CONFIG_FILE" ;;
  doctor)       cmd_doctor ;;
  version|--version|-v) echo "devopen $VERSION" ;;
  help|--help|-h) usage ;;
  *)            die "unknown command: $1 (try 'devopen help')" ;;
esac
